# Server
PORT=5000
NODE_ENV=development

# MongoDB — replace USER, PASSWORD, and cluster host with your own.
# Get this from MongoDB Atlas → "Connect" → "Drivers" → copy the URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pharma?retryWrites=true&w=majority&appName=Cluster0

# JWT — generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Default Admin (used by seed script — change before running `npm run seed`)
ADMIN_NAME=Super Admin
ADMIN_PHONE=01700000000
ADMIN_EMAIL=pharmarashid9@gmail.com
ADMIN_PASSWORD=Rashidtamim20
